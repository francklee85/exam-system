# Application
APP_NAME="Online Exam System API"
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# JWT authentication. This secret is a development example only.
# Generate a unique, random secret for every non-development environment.
JWT_SECRET_KEY=dev-only-change-this-to-a-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Initial administrator used only by the explicit Seed command.
# These are development examples; change them before running Seed.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=ChangeMe-Admin-2026!

# MySQL connection used when the backend runs on the host machine.
# Replace the placeholder passwords in your local .env only.
DATABASE_URL=mysql+asyncmy://exam_user:change_me@127.0.0.1:3306/exam_system?charset=utf8mb4
MYSQL_DATABASE=exam_system
MYSQL_USER=exam_user
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_root_password
MYSQL_PORT=3306

# Frontend (only VITE_ variables are exposed to browser code)
VITE_API_BASE_URL=http://localhost:8000
