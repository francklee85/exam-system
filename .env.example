# Copy this file to .env and replace every CHANGE_ME value before deployment.
# Application
APP_NAME="Online Exam System API"
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=[]
APP_PORT=80

# Generate with: openssl rand -hex 32
# Production startup rejects this placeholder.
JWT_SECRET_KEY=CHANGE_ME_RANDOM_JWT_SECRET_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Seed is idempotent. Production startup rejects the password placeholder.
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=CHANGE_ME_STRONG_INITIAL_ADMIN_PASSWORD

# Compose uses the internal hostname "mysql". URL-encode reserved password
# characters in DATABASE_URL, while MYSQL_PASSWORD remains the literal value.
MYSQL_DATABASE=exam_system
MYSQL_USER=exam_user
MYSQL_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DATABASE_PASSWORD
DATABASE_URL=mysql+asyncmy://exam_user:CHANGE_ME_DATABASE_PASSWORD@mysql:3306/exam_system?charset=utf8mb4

# Backend initialization (single backend container in V1 Compose).
RUN_MIGRATIONS=true
RUN_SEED=true

# Frontend uses same-origin /api through Nginx in production.
VITE_API_BASE_URL=
